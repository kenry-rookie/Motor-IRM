# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo:  cp .env.example .env
# Keep this file up-to-date when you add new variables to `.env`, and update
# the schema in "/src/env.js" accordingly. Never put real secrets here.

# PostgreSQL local en Docker (docker-compose.yml). Puerto 5433 en la Mac.
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE?schema=public
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://motor_irm:motor_irm_dev@localhost:5433/motor_irm?schema=public"

# Base aparte para las pruebas de integración (npm test). Se borra en cada corrida.
TEST_DATABASE_URL="postgresql://motor_irm:motor_irm_dev@localhost:5433/motor_irm_test?schema=public"

# Primer usuario administrador que crea el seed (npm run db:seed).
# Cambia la contraseña después de entrar por primera vez.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="cambiar-esta-clave"

# true = el seed también carga datos de demostración (productos, clientes, mecánicos).
SEED_DEMO="true"
